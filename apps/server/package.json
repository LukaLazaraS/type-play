{
  "name": "@typeplay/server",
  "private": true,
  "type": "module",
  "description": "The TypePlay API (NestJS, port 3002): users, projects, game agent runs, versions, credits",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "prisma generate && tsc --noEmit -p tsconfig.json && eslint .",
    "lint": "eslint .",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "admin": "tsx src/admin.ts",
    "paddle:catalog": "tsx scripts/paddle-catalog.ts",
    "test:e2e": "node test/e2e.mjs",
    "test:ledger": "node test/ledger-math.mjs",
    "test:billing": "node test/billing.mjs",
    "test:proxy": "node test/key-proxy.mjs",
    "test:android": "node test/android.mjs",
    "test:android:e2e": "node test/android-e2e.mjs",
    "r2:check": "tsx scripts/r2-check.ts",
    "runner": "node runner/runner.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@typeplay/shared": "*",
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/pg": "^8",
    "eslint": "^9",
    "prisma": "^7.10.1",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
