# Read by `next dev` only; `next build` never loads this file, so the live site stays without the app.
# No secrets here: this file is committed.

# The signed-in app (/create, /games, sign-in). Off in the live build until the API has a server.
NEXT_PUBLIC_APP=1

# Where the API runs (apps/server).
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3002

# "Dev sign-in" on /create for tests (needs the API started with DEV_AUTH=1). Off by default;
# turn it on in .env.local or on the command line: NEXT_PUBLIC_DEV_AUTH=1 npm run dev -w web
# NEXT_PUBLIC_DEV_AUTH=1

# Paddle (payments part 3). The client-side token comes from Paddle > Developer tools > Authentication
# in the sandbox dashboard (sandbox-vendors.paddle.com): "Client-side tokens" > New, named typeplay-web.
# A sandbox token starts with test_, a live one with live_ (live ones build only for production).
# Public by design: it goes to every browser. Without it the billing pages say "opens here soon".
# Set both in .env.local (git-ignored) with the API's PADDLE_ENV=sandbox in the root .env.
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_…
