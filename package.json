{
  "name": "typeplay",
  "private": true,
  "description": "TypePlay: type a game, play it, ship it. Monorepo: apps/ deploy on their own, packages/ are shared libraries.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@10.8.1"
}
